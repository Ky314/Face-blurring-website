<div class="max-w-xl mx-auto mt-10 p-6 bg-white rounded-lg shadow-md text-center">
  <h1 class="text-2xl font-bold mb-6 text-gray-800">モザイク処理完了</h1>

  <!-- 動画プレビュー -->
  <div class="mb-6 flex justify-center">
    <video width="100%" controls class="rounded shadow max-h-96">
      <source src="<%= @video_url %>" type="video/mp4">
      お使いのブラウザは動画タグをサポートしていません。
    </video>
  </div>

  <!-- アクションボタン -->
  <div class="flex flex-col gap-4">
    <!-- ダウンロードボタン -->
    <a href="<%= @video_url %>" download="mosaic_video.mp4" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 px-4 rounded transition">
      動画をダウンロードする
    </a>

    <!-- 戻るリンク -->
    <%= link_to "別の動画を処理する", root_path, class: "text-gray-600 hover:underline mt-2" %>
  </div>
</div>